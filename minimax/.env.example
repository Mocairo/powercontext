# Copy outside the repository to /home/lijx/.config/oceanbase/minimax.env.
# Fill the exact values provided for your MiniMax account region and plan.
# Official compatible base example for the international service: https://api.minimax.io/v1
# Do not use an Anthropic endpoint or append /chat/completions here.
MINIMAX_BASE_URL=<your-minimax-https-base-ending-in-/v1>
MINIMAX_API_KEY=<your-minimax-api-key>
MINIMAX_MODEL=<exact-model-id-supported-by-your-plan>
